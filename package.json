{
  "name": "quality-agents",
  "version": "0.2.1",
  "private": true,
  "description": "Portable, vendor-neutral Agent Skills for software quality engineering.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "qa": "scripts/qa.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "qa": "node scripts/qa.ts",
    "app:build": "node scripts/build-desktop.mjs",
    "app:dev": "node scripts/build-desktop.mjs && electron .",
    "typecheck": "tsc -p tsconfig.json && tsc -p app/tsconfig.json",
    "build": "node scripts/build.mjs",
    "validate": "node scripts/validate.mjs",
    "check": "node scripts/validate.mjs && node scripts/check-artifacts.mjs --all && node scripts/check-secrets.mjs --all",
    "test": "node --test",
    "test:ui": "node scripts/build-desktop.mjs && playwright test -c tests/ui/playwright.config.ts",
    "bundle": "node scripts/bundle.mjs",
    "new-project": "node scripts/new-project.mjs",
    "new-run": "node scripts/new-run.mjs",
    "runs": "node scripts/runs.mjs",
    "xlsx": "node scripts/xlsx.mjs",
    "pdf": "node scripts/pdf.mjs",
    "docx": "node scripts/docx.mjs",
    "check-output": "node scripts/check-output.mjs",
    "dist:win": "node scripts/build-desktop.mjs && electron-builder --win nsis",
    "dist:mac": "node scripts/build-desktop.mjs && electron-builder --mac dmg",
    "dist:linux": "node scripts/build-desktop.mjs && electron-builder --linux AppImage deb rpm"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.18.12",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "5.0.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron": "43.7.8",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "main": "app/dist-electron/boot.mjs",
  "desktopName": "quality-agents.desktop",
  "author": "Moki contributors",
  "build": {
    "appId": "io.github.orsi88.qualityagents",
    "productName": "Moki",
    "copyright": "MIT License",
    "directories": {
      "app": "build/app",
      "output": "release"
    },
    "files": [
      "**/*"
    ],
    "asarUnpack": [
      "app/dist-electron/run-tool.mjs",
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "AGENTS.md",
        "to": "framework/AGENTS.md"
      },
      {
        "from": "CLAUDE.md",
        "to": "framework/CLAUDE.md"
      },
      {
        "from": "README.md",
        "to": "framework/README.md"
      },
      {
        "from": "README.pt-BR.md",
        "to": "framework/README.pt-BR.md"
      },
      {
        "from": "LICENSE",
        "to": "framework/LICENSE"
      },
      {
        "from": "core",
        "to": "framework/core"
      },
      {
        "from": "skills",
        "to": "framework/skills"
      },
      {
        "from": "agents",
        "to": "framework/agents"
      },
      {
        "from": ".agents",
        "to": "framework/.agents"
      },
      {
        "from": ".claude",
        "to": "framework/.claude",
        "filter": [
          "skills/**",
          "agents/**"
        ]
      },
      {
        "from": "templates",
        "to": "framework/templates"
      },
      {
        "from": "schemas",
        "to": "framework/schemas"
      },
      {
        "from": "adapters",
        "to": "framework/adapters"
      },
      {
        "from": "docs",
        "to": "framework/docs"
      },
      {
        "from": "examples",
        "to": "framework/examples"
      },
      {
        "from": "scripts",
        "to": "framework/scripts"
      },
      {
        "from": "workspace/README.md",
        "to": "framework/workspace/README.md"
      },
      {
        "from": "build/framework-package.json",
        "to": "framework/package.json"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "app/public/icon.png",
      "artifactName": "Moki.Setup.${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Moki"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "app/public/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "app/public/icon-512.png",
      "category": "Development",
      "maintainer": "Moki contributors",
      "syncDesktopName": true
    },
    "electronVersion": "43.7.8"
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  }
}
