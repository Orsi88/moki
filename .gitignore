# ---------------------------------------------------------------
# Moki — artifact isolation policy
# Everything received or produced while running skills lives in
# workspace/ and is NEVER versioned. See docs/privacy-and-isolation.md.
# .gitignore is a convenience, not a security control: the pre-commit
# hook and CI run scripts/check-artifacts.mjs as a second barrier.
# ---------------------------------------------------------------
/workspace/*
!/workspace/README.md
# Other workspaces created by the desktop app
/workspaces/

# Generated distribution bundles (chat bundles, skill zips)
/dist/

# Local tooling
node_modules/
.env
.env.*
*.local.md
CLAUDE.local.md
AGENTS.local.md
AGENTS.override.md
.claude/settings.local.json
.claude/worktrees/
.cursor/
.vscode/
.idea/

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Playwright UI run (npm run test:ui)
/tests/ui/results/

# Built desktop app (generated by npm run setup / npm run app:build)
/app/dist/
/app/dist-electron/
# Browser bundle for diagram pictures in exported PDFs (generated by app:build)
/scripts/lib/diagram-frame.iife.js

# Built VS Code extension (generated by npm run vscode:build)
/ide/vscode/dist/
/ide/vscode/LICENSE

# Installers (generated by npm run dist:win / dist:mac / dist:linux)
/release/
/build/
